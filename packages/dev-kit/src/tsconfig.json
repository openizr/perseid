{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "newLine": "LF",
    "strict": true,
    "target": "ES6",
    "lib": [
      "ES6",
      "ES7",
      "DOM",
      "DOM.Iterable",
      "ScriptHost"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "skipLibCheck": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "*": [
        "${configDir}/src/*"
      ]
    },
    "types": [
      "@perseid/dev-kit/types"
    ]
  },
  "include": [
    "${configDir}/src"
  ]
}
