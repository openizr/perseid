    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && mkdir dist && rsync -av src/ dist/ --exclude=__playground__ && cp LICENSE README.md package.json dist/",
    "dev": "yarn run build && sh -c 'inotifywait -m -r -e modify,create,delete,move --exclude __playground__ src package.json README.md LICENSE | while read -r _; do rsync -au --delete src/ dist/ --exclude=__playground__ --exclude=package.json --exclude=LICENSE --exclude=README.md && cp package.json README.md LICENSE dist/; done'"
  },
  "engines": {
    "node": ">= 22.12.0",
    "npm": ">= 10.0.0"
  },
  "browserslist": [
    "defaults"
  ]
