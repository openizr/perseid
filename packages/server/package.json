{
  "name": "@perseid/server",
  "version": "10.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./core.js",
  "exports": {
    ".": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./mongodb": {
      "types": "./mongodb.d.ts",
      "default": "./mongodb.js"
    },
    "./mysql": {
      "types": "./mysql.d.ts",
      "default": "./mysql.js"
    },
    "./postgresql": {
      "types": "./postgresql.d.ts",
      "default": "./postgresql.js"
    },
    "./express": {
      "types": "./express.d.ts",
      "default": "./express.js"
    },
    "./fastify": {
      "types": "./fastify.d.ts",
      "default": "./fastify.js"
    }
  },
  "description": "Dynamic, data model-based REST APIs generator",
  "homepage": "https://github.com/openizr/perseid",
  "repository": "https://github.com/openizr/perseid",
  "bugs": "https://github.com/openizr/perseid/issues",
  "contributors": [
    {
      "name": "Matthieu Jabbour",
      "email": "matthieu.jabbour@gmail.com",
      "homepage": "https://github.com/matthieujabbour"
    }
  ],
  "keywords": [
    "perseid",
    "server",
    "api",
    "generator",
    "rest"
  ],
  "devDependencies": {
    "@perseid/dev-kit": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multiparty": "^0.0.36",
    "@types/pg": "^8.11.6",
    "tsc-alias": "^1.8.16"
  },
  "eslintConfig": {
    "extends": [
      "./node_modules/@perseid/dev-kit/main.cjs"
    ],
    "overrides": [
      {
        "files": [
          "src/__mocks__/**/*.ts"
        ],
        "rules": {
          "max-classes-per-file": "off",
          "no-await-in-loop": "off"
        }
      },
      {
        "files": [
          "*.test.ts"
        ],
        "rules": {
          "@typescript-eslint/unbound-method": "off"
        }
      },
      {
        "files": [
          "*.d.ts"
        ],
        "rules": {
          "no-shadow": "off",
          "import/order": "off",
          "import/named": "off",
          "import/export": "off",
          "import/no-cycle": "off",
          "import/no-duplicates": "off",
          "no-use-before-define": "off",
          "import/no-unresolved": "off",
          "import/no-self-import": "off",
          "@typescript-eslint/no-explicit-any": "off",
          "import/no-extraneous-dependencies": "off",
          "import/no-relative-packages": "off",
          "max-classes-per-file": "off"
        }
      },
      {
        "files": [
          "*.ts"
        ],
        "rules": {
          "@typescript-eslint/no-unnecessary-type-parameters": "off"
        }
      },
      {
        "files": [
          "src/scripts/connectors/fastify/services/FastifyController.ts"
        ],
        "rules": {
          "@typescript-eslint/no-explicit-any": "off"
        }
      }
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.207.0",
    "@perseid/core": "file:/var/lib/perseid/core",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "multiparty": "^4.2.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "peerDependencies": {
    "express": "^4.19.2",
    "fastify": "^4.28.1",
    "mongodb": "^6.8.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devKitConfig": {
    "target": "node",
    "runInDev": true,
    "splitChunks": true,
    "entries": {
      "core": "./scripts/core.ts",
      "fastify-connector": "./scripts/fastify-connector.ts",
      "postgresql-connector": "./scripts/postgresql-connector.ts"
    },
    "srcPath": "src",
    "distPath": "dist",
    "banner": "/*!\n * Copyright (c) Openizr. All Rights Reserved.\n *\n * This source code is licensed under the MIT license found in the\n * LICENSE file in the root directory of this source tree.\n */"
  },
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 9.0.0"
  },
  "scripts": {
    "test": "node_modules/@perseid/dev-kit/scripts/test",
    "dev": "node node_modules/@perseid/dev-kit/scripts/dev.js",
    "check": "node node_modules/@perseid/dev-kit/scripts/check.js",
    "build": "node node_modules/@perseid/dev-kit/scripts/build.js && yarn run build:types",
    "build:types": "./node_modules/.bin/tsc --project tsconfig.json --emitDeclarationOnly --noEmit false --outDir dist --declaration && find dist -name \"__tests__\" -type d -exec rm -rf {} + && find dist -name \"__mocks__\" -type d -exec rm -rf {} + && mv dist/scripts/** dist && rm -rf dist/__playground__ && rm -rf dist/scripts && ./node_modules/.bin/tsc-alias -p tsconfig.json --outDir dist && mv dist/fastify-connector.js dist/fastify.js && mv dist/postgresql-connector.js dist/postgresql.js && mv dist/fastify-connector.d.ts dist/fastify.d.ts && mv dist/postgresql-connector.d.ts dist/postgresql.d.ts && mv dist/fastify-connector.js.map dist/fastify.js.map && mv dist/postgresql-connector.js.map dist/postgresql.js.map",
    "postinstall": "rm -f node_modules/.eslintcache && mkdir -p node_modules/.cache && test -n \"$POSTINSTALLED\" || POSTINSTALLED=1 yarn add --peer mysql2@^3.11.0 pg@^8.12.0 mongodb@^6.8.0 fastify@^4.28.1 express@^4.19.2"
  }
}
