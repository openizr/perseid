{
  "name": "@perseid/jobs",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./core.js",
  "types": "./core.d.ts",
  "exports": {
    ".": {
      "default": "./core.js",
      "types": "./core.d.ts"
    },
    "./mongodb": {
      "default": "./mongodb.js",
      "types": "./mongodb.d.ts"
    },
    "./mysql": {
      "default": "./mysql.js",
      "types": "./mysql.d.ts"
    },
    "./postgresql": {
      "default": "./postgresql.js",
      "types": "./postgresql.d.ts"
    }
  },
  "description": "Fast, scalable job scheduler",
  "homepage": "https://github.com/openizr/perseid",
  "repository": "https://github.com/openizr/perseid",
  "bugs": "https://github.com/openizr/perseid/issues",
  "contributors": [
    {
      "name": "Matthieu Jabbour",
      "email": "matthieu.jabbour@gmail.com",
      "homepage": "https://github.com/matthieujabbour"
    }
  ],
  "keywords": [
    "perseid",
    "job",
    "scheduler",
    "tasks",
    "cron"
  ],
  "devDependencies": {
    "@perseid/dev-kit": "^10.0.0",
    "@types/pg": "^8.11.6",
    "tsc-alias": "^1.8.16"
  },
  "eslintConfig": {
    "extends": [
      "./node_modules/@perseid/dev-kit/main.cjs"
    ],
    "overrides": [
      {
        "files": [
          "*.d.ts",
          "src/__mocks__/**/*.ts"
        ],
        "rules": {
          "max-classes-per-file": "off",
          "no-await-in-loop": "off"
        }
      },
      {
        "files": [
          "*.test.ts"
        ],
        "rules": {
          "@typescript-eslint/unbound-method": "off"
        }
      },
      {
        "files": [
          "JobScheduler.ts"
        ],
        "rules": {
          "@typescript-eslint/no-dynamic-delete": "off"
        }
      },
      {
        "files": [
          "*.d.ts"
        ],
        "rules": {
          "no-shadow": "off",
          "import/order": "off",
          "import/named": "off",
          "import/export": "off",
          "import/no-cycle": "off",
          "import/no-duplicates": "off",
          "no-use-before-define": "off",
          "import/no-unresolved": "off",
          "import/no-self-import": "off",
          "@typescript-eslint/no-explicit-any": "off",
          "import/no-extraneous-dependencies": "off",
          "import/no-relative-packages": "off",
          "max-classes-per-file": "off"
        }
      }
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@perseid/core": "file:../../lib/perseid/core",
    "@perseid/server": "file:../../lib/perseid/server"
  },
  "peerDependencies": {
    "mongodb": "^6.8.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devKitConfig": {
    "target": "node",
    "runInDev": true,
    "splitChunks": true,
    "entries": {
      "core": "./scripts/core.ts",
      "playground": "./__playground__/index.ts",
      "postgresql-connector": "./scripts/postgresql-connector.ts"
    },
    "srcPath": "src",
    "distPath": "dist",
    "banner": "/*!\n * Copyright (c) Openizr. All Rights Reserved.\n *\n * This source code is licensed under the MIT license found in the\n * LICENSE file in the root directory of this source tree.\n */"
  },
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 9.0.0"
  },
  "scripts": {
    "play": "node --watch dist/playground.js",
    "test": "node_modules/@perseid/dev-kit/scripts/test",
    "dev": "node node_modules/@perseid/dev-kit/scripts/dev.js",
    "check": "node node_modules/@perseid/dev-kit/scripts/check.js",
    "build": "node node_modules/@perseid/dev-kit/scripts/build.js --force && yarn run build:types",
    "build:types": "./node_modules/.bin/tsc --project tsconfig.json --emitDeclarationOnly --noEmit false --outDir dist --declaration && find dist -name \"__tests__\" -type d -exec rm -rf {} + && find dist -name \"__mocks__\" -type d -exec rm -rf {} + && mv dist/scripts/** dist && rm -rf dist/__playground__ && rm -rf dist/scripts && ./node_modules/.bin/tsc-alias -p tsconfig.json --outDir dist && mv dist/postgresql-connector.js dist/postgresql.js && mv dist/postgresql-connector.d.ts dist/postgresql.d.ts && mv dist/postgresql-connector.js.map dist/postgresql.js.map",
    "postinstall": "rm -f node_modules/.eslintcache && mkdir -p node_modules/.cache && test -n \"$POSTINSTALLED\" || POSTINSTALLED=1 yarn add --peer mysql2@^3.11.0 pg@^8.12.0 mongodb@^6.8.0"
  }
}