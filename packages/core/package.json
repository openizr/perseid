{
  "name": "@perseid/core",
  "version": "10.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./index.node.js",
  "description": "Contains isomorphic core features, types definitions and helpers necessary to other perseid packages",
  "repository": "https://github.com/openizr/perseid",
  "bugs": "https://github.com/openizr/perseid/issues",
  "exports": {
    ".": {
      "node": {
        "import": "./index.node.js",
        "require": "./index.node.js"
      },
      "browser": {
        "import": "./index.browser.js",
        "require": "./index.browser.js"
      }
    }
  },
  "contributors": [
    {
      "name": "Matthieu Jabbour",
      "email": "matthieu.jabbour@gmail.com",
      "homepage": "https://github.com/matthieujabbour"
    }
  ],
  "keywords": [
    "perseid",
    "core",
    "helpers",
    "isomorphic"
  ],
  "devDependencies": {
    "@perseid/dev-kit": "^10.0.0",
    "tsc-alias": "^1.8.16"
  },
  "eslintConfig": {
    "extends": [
      "./node_modules/@perseid/dev-kit/main.cjs"
    ],
    "overrides": [
      {
        "files": [
          "src/scripts/classes/NodeId.ts",
          "src/scripts/classes/BrowserId.ts"
        ],
        "rules": {
          "no-bitwise": "off"
        }
      },
      {
        "files": "src/scripts/classes/Model.ts",
        "rules": {
          "no-use-before-define": "off"
        }
      },
      {
        "files": "src/scripts/helpers/forEach.ts",
        "rules": {
          "no-await-in-loop": "off"
        }
      }
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.207.0",
    "uuid": "13.0.0"
  },
  "devKitConfig": {
    "target": "node",
    "entries": {
      "index.node": "./scripts/index.node.ts",
      "index.browser": "./scripts/index.browser.ts"
    },
    "srcPath": "src",
    "distPath": "dist",
    "banner": "/*!\n * Copyright (c) Openizr. All Rights Reserved.\n *\n * This source code is licensed under the MIT license found in the\n * LICENSE file in the root directory of this source tree.\n */"
  },
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 9.0.0"
  },
  "scripts": {
    "test": "node_modules/@perseid/dev-kit/scripts/test",
    "dev": "node node_modules/@perseid/dev-kit/scripts/dev.js",
    "build:types": "./node_modules/.bin/tsc --project tsconfig.json --emitDeclarationOnly --noEmit false --outDir dist --declaration && find dist -name \"__tests__\" -type d -exec rm -rf {} + 2>/dev/null || true && find dist -name \"__mocks__\" -type d -exec rm -rf {} + && mv dist/src/scripts/* dist && rm -rf dist/src && rm -rf dist/dist && ./node_modules/.bin/tsc-alias -p tsconfig.json --outDir dist && mv dist/index.*.d.ts dist",
    "build": "node node_modules/@perseid/dev-kit/scripts/build.js && yarn run build:types",
    "check": "node node_modules/@perseid/dev-kit/scripts/check.js",
    "postinstall": "rm -f node_modules/.eslintcache"
  }
}
